{
  "info": {
    "name": "Role Changes & Change Requests Tests",
    "description": "Tests for the new user roles and change request approval workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Change Requests Workflow (EDITOR & ADMIN)",
      "item": [
        {
          "name": "1.1 Submit a Change Request as EDITOR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{EDITOR_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetTable\": \"mous\",\n  \"actionType\": \"CREATE\",\n  \"payload\": {\n    \"partner_university_id\": \"<valid_uuid>\",\n    \"signed_date\": \"2026-06-01T00:00:00Z\",\n    \"expiry_date\": \"2030-06-01T00:00:00Z\",\n    \"status\": \"ACTIVE\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/change-requests",
              "host": ["{{baseUrl}}"],
              "path": ["change-requests"]
            }
          }
        },
        {
          "name": "1.2 View Change Requests as ADMIN",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/change-requests?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["change-requests"],
              "query": [
                { "key": "status", "value": "PENDING" }
              ]
            }
          }
        },
        {
          "name": "1.3 Approve the Change Request as ADMIN",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/change-requests/:request_id/approve",
              "host": ["{{baseUrl}}"],
              "path": ["change-requests", ":request_id", "approve"],
              "variable": [
                { "key": "request_id", "value": "<insert_request_id_from_step_1.2>" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Editor Student Features",
      "item": [
        {
          "name": "2.1 Editor Viewing Own Applications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{EDITOR_TOKEN}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/me",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "me"]
            }
          }
        },
        {
          "name": "2.2 Editor Applying for a Program",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{EDITOR_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programId\": \"<valid_program_uuid>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        }
      ]
    },
    {
      "name": "3. VIEWER Access Control",
      "item": [
        {
          "name": "3.1 Viewer Accessing Analytics (Allowed)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{VIEWER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/overview",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "overview"]
            }
          }
        },
        {
          "name": "3.2 Viewer Accessing MOUs (Allowed)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{VIEWER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/mous",
              "host": ["{{baseUrl}}"],
              "path": ["mous"]
            }
          }
        },
        {
          "name": "3.3 Viewer Accessing Users Directory (Blocked)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{VIEWER_TOKEN}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        }
      ]
    },
    {
      "name": "4. SUPER_ADMIN vs ADMIN Permissions",
      "item": [
        {
          "name": "4.1 Admin trying to change user role (Blocked)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"SUPER_ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/:user_id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":user_id"],
              "variable": [
                { "key": "user_id", "value": "<some_user_id>" }
              ]
            }
          }
        },
        {
          "name": "4.2 Super Admin changing user role (Allowed)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{SUPER_ADMIN_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/:user_id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":user_id"],
              "variable": [
                { "key": "user_id", "value": "<some_user_id>" }
              ]
            }
          }
        },
        {
          "name": "4.3 Admin deleting a user (Blocked)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/:user_id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":user_id"],
              "variable": [
                { "key": "user_id", "value": "<some_user_id>" }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1",
      "type": "string"
    },
    {
      "key": "SUPER_ADMIN_TOKEN",
      "value": "your_super_admin_jwt_here",
      "type": "string"
    },
    {
      "key": "ADMIN_TOKEN",
      "value": "your_admin_jwt_here",
      "type": "string"
    },
    {
      "key": "EDITOR_TOKEN",
      "value": "your_editor_jwt_here",
      "type": "string"
    },
    {
      "key": "VIEWER_TOKEN",
      "value": "your_viewer_jwt_here",
      "type": "string"
    }
  ]
}
